# Copy this file to .env and fill in real values for local development.
# See config/env.go for how these are loaded and their fallback defaults.

# --- Server ---
PUBLIC_HOST=http://localhost
PORT=8080

# --- CORS ---
FRONTEND_URL=http://localhost:3000
# Optional: additional allowed origin for the deployed frontend
PRODUCTION_FRONTEND_URL=

# --- Auth ---
JWT_SECRET=
JWT_EXP_IN_SEC=604800

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=animal_family
DB_SSL_MODE=disable

# --- Web Push (VAPID) ---
# Generate with: go run cmd/vapidgen/main.go
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@animalfamily.app

# --- Species lookup / AI ---
OPENAI_API_KEY=

# --- AWS (S3 for species/animal images) ---
S3_ASSETS_BUCKET=brindl-assets
AWS_REGION=us-east-1
